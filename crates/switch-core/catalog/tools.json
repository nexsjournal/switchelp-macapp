    {
      "id": "github-cli",
      "names": { "zh-Hans": "GitHub CLI", "en": "GitHub CLI" },
      "category": "utility",
      "website": "https://cli.github.com/",
      "docs": "https://cli.github.com/manual/",
      "command": "gh",
      "requireConfigFile": false,
      "modelConfig": false,
      "description": "官方 GitHub 命令行。它用 GitHub 自己的身份认证，没有模型可选。",
      "readiness": {
        "versionArgs": ["--version"],
        "okExit": 0,
        "cacheSeconds": 300,
        "staticAny": ["~/.config/gh/hosts.yml"]
      },
      "authCheck": {
        "args": ["auth", "status"],
        "okExit": 0,
        "needsLoginPatterns": ["not logged into", "未登录", "authentication"]
      },
      "agentUsage": {
        "tags": ["代码托管", "GitHub"],
        "nonInteractive": [
          "gh repo clone <owner/repo>",
          "gh pr create --fill",
          "gh issue list",
          "gh api <endpoint>"
        ]
      },
      "paths": {
        "macos": ["/opt/homebrew/bin/gh", "/usr/local/bin/gh"],
        "windows": ["%PROGRAMFILES%/GitHub CLI/gh.exe"],
        "linux": ["/usr/bin/gh", "/usr/local/bin/gh"]
      }
    },
