{
  "schemaVersion": 1,
  "tools": [
    {
      "id": "codex",
      "names": { "zh-Hans": "Codex CLI", "en": "Codex CLI" },
      "category": "cliCode",
      "website": "https://github.com/openai/codex",
      "docs": "https://github.com/openai/codex",
      "command": "codex",
      "configDir": "~/.codex",
      "configFile": "~/.codex/config.toml",
      "requireConfigFile": false,
      "modelConfig": true,
      "skillsRoot": "~/.codex/skills",
      "description": "OpenAI 的编码 agent CLI。本工具的供应商与模型配置最终写进它的 config.toml。",
      "readiness": {
        "versionArgs": ["--version"],
        "okExit": 0,
        "cacheSeconds": 300,
        "staticAny": ["~/.codex/config.toml"]
      },
      "agentUsage": {
        "tags": ["编码 agent", "CLI"],
        "nonInteractive": ["codex exec \"<任务>\"", "codex --help"]
      },
      "paths": {
        "macos": [
          "/opt/homebrew/bin/codex",
          "/usr/local/bin/codex",
          "~/.npm-global/bin/codex",
          "~/.local/bin/codex",
          "~/.bun/bin/codex",
          "~/Library/pnpm/codex"
        ],
        "windows": [
          "%APPDATA%/npm/codex.cmd",
          "%USERPROFILE%/.local/bin/codex.exe",
          "%LOCALAPPDATA%/pnpm/codex.exe"
        ],
        "linux": [
          "/usr/local/bin/codex",
          "/usr/bin/codex",
          "~/.npm-global/bin/codex",
          "~/.local/bin/codex"
        ]
      }
    },
