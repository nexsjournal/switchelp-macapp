      "readiness": {
        "versionArgs": ["--version"],
        "okExit": 0,
        "cacheSeconds": 300,
        "staticAny": ["~/.claude/settings.json"]
      },
      "agentUsage": {
        "tags": ["编码 agent", "CLI"],
        "nonInteractive": ["claude -p \"<任务>\"", "claude --help"]
      },
      "paths": {
        "macos": [
          "/opt/homebrew/bin/claude",
          "/usr/local/bin/claude",
          "~/.npm-global/bin/claude",
          "~/.local/bin/claude",
          "~/.claude/local/claude"
        ],
        "windows": [
          "%APPDATA%/npm/claude.cmd",
          "%USERPROFILE%/.local/bin/claude.exe"
        ],
        "linux": [
          "/usr/local/bin/claude",
          "~/.npm-global/bin/claude",
          "~/.local/bin/claude"
        ]
      }
    },
